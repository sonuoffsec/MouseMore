{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MouseMore",
  "version": "0.1.0",
  "identifier": "org.mousemore.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MouseMore",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "backgroundColor": "#0b0c0f",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Your mouse can do more.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "MouseMore"
      }
    }
  }
}
